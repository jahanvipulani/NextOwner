# Render Blueprint: backend web service + PostgreSQL. The frontend goes on Vercel (see DEPLOY.md).
services:
  - type: web
    name: nextowner-backend
    runtime: docker
    dockerfilePath: ./backend/Dockerfile
    dockerContext: ./backend
    healthCheckPath: /health
    plan: free
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: nextowner-db
          property: connectionString
      - key: SECRET_KEY
        generateValue: true
      - key: CORS_ORIGINS
        sync: false          # set to your Vercel address, e.g. https://nextowner.vercel.app
      - key: SEED_DEMO_DATA
        value: "true"
      - key: LLM_API_KEY
        sync: false          # optional
      - key: LLM_MODEL
        value: claude-sonnet-5-5

databases:
  - name: nextowner-db
    plan: free
    databaseName: nextowner
    user: nextowner