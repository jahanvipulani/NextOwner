# Copy to .env and edit. Every value here is a placeholder, not a real credential.
# `docker compose up --build` also works without a .env file, using safe local defaults.

POSTGRES_USER=nextowner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nextowner

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# Optional. Leave LLM_API_KEY empty to use the built-in rule-based extractor.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Optional. Raises the GitHub rate limit when importing a public repository.
GITHUB_TOKEN=

MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
# Loads the synthetic "Student Research Portal" project and demo accounts on first start.
SEED_DEMO_DATA=true
